<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ArArNote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Modern Clean Popup / Overflow Menu: White Rounded Card with Elevation -->
        <item name="popupMenuStyle">@style/Widget.ArArNote.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.ArArNote.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.ArArNote.ActionOverflowMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/Widget.ArArNote.ActionOverflowMenu</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.ArArNote.PopupMenu</item>
        <item name="android:actionBarPopupTheme">@style/ThemeOverlay.ArArNote.PopupMenu</item>
        <item name="android:panelBackground">@drawable/bg_popup_menu</item>
        <item name="panelBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- Toolbar Title Text Appearance: Zero background artifact, crisp white typography -->
    <style name="TextAppearance.ArArNote.Toolbar.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Toolbar Overlay: White text/icons, transparent background for child views so title text has no box artifact -->
    <style name="ThemeOverlay.ArArNote.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="subtitleTextColor">#E0E0E0</item>
        <item name="titleTextAppearance">@style/TextAppearance.ArArNote.Toolbar.Title</item>
        <item name="android:background">@null</item>
        <item name="android:itemBackground">@null</item>
        <item name="actionOverflowMenuStyle">@style/Widget.ArArNote.ActionOverflowMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/Widget.ArArNote.ActionOverflowMenu</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.ArArNote.PopupMenu</item>
        <item name="android:actionBarPopupTheme">@style/ThemeOverlay.ArArNote.PopupMenu</item>
    </style>

    <!-- Popup Menu Overlay: Clean white rounded card with dark text -->
    <style name="ThemeOverlay.ArArNote.PopupMenu" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#212121</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:itemBackground">?attr/selectableItemBackground</item>
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:panelBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- Popup Menu Widget Style -->
    <style name="Widget.ArArNote.PopupMenu" parent="Widget.AppCompat.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:textColor">#212121</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <!-- Action Overflow Menu Widget Style -->
    <style name="Widget.ArArNote.ActionOverflowMenu" parent="Widget.AppCompat.Light.ActionButton.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:textColor">#212121</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <style name="Widget.ArArNote.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">#FFFFFF</item>
        <item name="subtitleTextColor">#E0E0E0</item>
        <item name="titleTextAppearance">@style/TextAppearance.ArArNote.Toolbar.Title</item>
    </style>

    <style name="CalendarHeaderDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
