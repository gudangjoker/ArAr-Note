<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/note_yellow_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/note_yellow_header"
        android:theme="@style/Widget.ArArNote.Toolbar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light" />

    <!-- Title Input -->
    <EditText
        android:id="@+id/edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/hint_title"
        android:inputType="textCapSentences"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/note_yellow_text"
        android:textColorHint="#90A4AE"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Divider -->
    <View
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20000000" />

    <!-- Checklist Items List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_checklist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <!-- Quick Actions Bar (Organize / Move checked) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#15000000"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btn_move_checked"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Move Checked to Bottom"
            android:textColor="@color/note_yellow_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_delete_checked"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete Checked"
            android:textColor="@color/note_red_header"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bottom Add Item Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#10000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/edit_new_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_note_card"
            android:hint="@string/hint_add_item"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btn_add_item"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_note_card"
            android:contentDescription="@string/action_add_note"
            android:src="@drawable/ic_add"
            app:tint="@color/primary" />

    </LinearLayout>

</LinearLayout>
